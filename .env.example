# openwright configuration — copy to .env (or export in your shell).
# Everything has a sane default; an empty .env is valid.

# Server port + bind address. Default binds 127.0.0.1 (local only);
# set OPENWRIGHT_HOST=0.0.0.0 to reach the app from other devices.
#OPENWRIGHT_PORT=8090
#OPENWRIGHT_HOST=127.0.0.1

# Default agent engine for new workspaces: claude | copilot | codex
#OPENWRIGHT_AGENT=claude

# ── Claude (Agent SDK) ────────────────────────────────────────────
# Either set an API key, or log in once with `claude login`
# (Claude Code credentials are picked up automatically).
#ANTHROPIC_API_KEY=sk-ant-...
#OPENWRIGHT_CLAUDE_MODEL=claude-sonnet-4-6

# ── GitHub Copilot CLI ───────────────────────────────────────────
# Run `copilot` once and use /login (recommended), or set a
# FINE-GRAINED PAT with Copilot permission (classic ghp_ tokens are
# rejected by the CLI):
#COPILOT_GITHUB_TOKEN=github_pat_...
#OPENWRIGHT_COPILOT_MODEL=auto
#OPENWRIGHT_COPILOT_BIN=copilot

# ── OpenAI Codex CLI ─────────────────────────────────────────────
# Run `codex login` (ChatGPT account) or `codex login --api-key`.
#OPENWRIGHT_CODEX_BIN=codex

# ── Agent runner tuning ──────────────────────────────────────────
#OPENWRIGHT_MAX_TURNS=30
#OPENWRIGHT_IDLE_TIMEOUT_MS=600000
